# Copy to .env for local development: cp .env.example .env
# .env is git-ignored and must never contain production secrets.
# In production these are real environment variables, not a file.

# --- identity -----------------------------------------------------------------
SCHOOL_CODE=DEMO
APP_TIMEZONE=Asia/Kolkata

# --- database (transactions require a replica set) ----------------------------
# Local docker compose: single-node replica set.
MONGODB_URI=mongodb://localhost:27017/school?replicaSet=rs0&directConnection=true
# MongoDB Atlas: already a replica set, so drop replicaSet/directConnection. Keep the
# /<database> path segment — without it Spring Data has no default database. URL-encode
# any of : / ? # [ ] @ in the password.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/school?retryWrites=true&w=majority
#
# Put the real connection string in .env, never here: this file is committed.

# --- auth ---------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=local-dev-secret-please-replace-with-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Secure flag on the refresh cookie. False locally (plain http); never set it to false in production.
JWT_COOKIE_SECURE=false

# Used only on first boot to create the initial ADMIN (gets an EMP uniqueId).
BOOTSTRAP_ADMIN_EMAIL=admin@demo-school.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!234

# Base64 AES-256 key for employee bank details (B6). Generate with: openssl rand -base64 32
# This is a throwaway development value committed to the example file. Generate a fresh one for any
# real deployment, and keep it: account numbers written under this key cannot be read with another.
ENCRYPTION_KEY=TZB1rpIEFMvWaBYeJiZtmLfyrJFZcidCSkuJX0MSfiA=

# --- object storage (MinIO locally, any S3-compatible store in production) -----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=school-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
# Where public images (logo, favicon, gallery) are read from. Leave empty locally: MinIO serves them
# at STORAGE_ENDPOINT/STORAGE_BUCKET. In production set the R2 custom domain or public bucket URL,
# e.g. https://media.your-school.example
STORAGE_PUBLIC_BASE_URL=
STORAGE_MAX_IMAGE_SIZE=5MB
# Per-file limit for notice attachments (B10). Must stay under spring.servlet.multipart.max-file-size.
STORAGE_MAX_ATTACHMENT_SIZE=10MB

# --- first-boot seeding -------------------------------------------------------
# school_config is seeded from this file when the database has none. Override the location to use a
# real seed without rebuilding, e.g. file:./seed/school-seed.json
APP_SEED_ENABLED=true
APP_SEED_SCHOOL_CONFIG=classpath:seed/school-seed.json

# --- payments -----------------------------------------------------------------
# Razorpay test-mode keys from Dashboard → Account & Settings → API Keys. KEY_ID is publishable and
# is returned to the browser to open the checkout; KEY_SECRET signs the handshake and must not be.
# Leave all three empty and the online payment endpoints answer 503 — everything else still works,
# and the counter flow (POST /fees/offline-payment) does not need them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A separate secret, set when you create the webhook under Settings → Webhooks. Subscribe it to
# payment.captured and payment.failed, pointed at POST /api/v1/public/payments/webhook. With this
# empty, every inbound webhook is REJECTED rather than trusted — so locally, either tunnel the
# endpoint (e.g. ngrok) and set this, or rely on POST /payments/verify and the 15-minute
# reconciliation job, both of which settle through the same code.
RAZORPAY_WEBHOOK_SECRET=

# --- optional features --------------------------------------------------------
APP_FEATURES_AI=false
AI_API_KEY=

# SMTP is optional; notifications stay disabled unless it is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
